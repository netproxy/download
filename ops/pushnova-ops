#!/usr/bin/env bash
# =============================================================================
# PushNova Ops · Server Monitoring & Notification Tool (Main Entrypoint)
#
#   Quick Install:  curl -fsSL <install.sh url> | bash
#   Setup Wizard:   pushnova-ops install
#   Run Report:     pushnova-ops report
#   Check Anomaly:  pushnova-ops check
#   Send Manual:    pushnova-ops send -t "Title" -m "Body"
#   Diagnostics:    pushnova-ops doctor
#
# Configurations stored in /etc/pushnova-ops/ops.conf (~/.config/pushnova-ops/ops.conf for non-root)
# =============================================================================
set -euo pipefail

PN_OPS_VERSION="1.0.0"
PN_OPS_SELFDIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo .)
if [ -d "$PN_OPS_SELFDIR/lib" ]; then
  : "${PUSHNOVA_OPS_HOME:=$PN_OPS_SELFDIR}"
fi
export PN_OPS_SELFDIR
export PUSHNOVA_OPS_HOME="${PUSHNOVA_OPS_HOME:-}"

PN_LIB_DIR=""
for _cand in "${PUSHNOVA_OPS_HOME:-}/lib" "$PN_OPS_SELFDIR/lib" /usr/local/lib/pushnova-ops /opt/pushnova-ops/lib; do
  [ -n "$_cand" ] || continue
  if [ -f "$_cand/common.sh" ]; then PN_LIB_DIR=$_cand; break; fi
done
[ -n "$PN_LIB_DIR" ] || { echo "Error: PushNova Ops library not found (lib/common.sh)" >&2; exit 1; }

# shellcheck source=/dev/null
. "$PN_LIB_DIR/common.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/config.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/metrics.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/rules.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/payload.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/notify.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/schedule.sh"
# shellcheck source=/dev/null
. "$PN_LIB_DIR/wizard.sh"

# ---------------------------------------------------------------------------
# Argument Parsing (CLI > Env > Config > Defaults)
# ---------------------------------------------------------------------------
PN_FLAG_JSON=0
PN_FLAG_YES=0
PN_FLAG_NO_TEST=0
PN_FLAG_FORCE=0
PN_FLAG_PURGE=0
PN_FLAG_TEMPLATE=""
PN_FLAG_TITLE=""
PN_FLAG_MESSAGE=""
PN_FLAG_TYPE=""
PN_CMD=""
PN_ARGS=""
PN_TAIL=""

pn_usage() {
  cat <<EOF
$(pn_c bold 'PushNova Ops v'"$PN_OPS_VERSION") · Server Operations Monitoring & Push Tool

$(pn_c bold 'Usage')
  $PN_OPS_NAME <command> [options]

$(pn_c bold 'Commands')
  install, wizard      Run interactive CLI setup wizard
  report               Inspect host immediately and push report
  check                Run anomaly check (pushes only on alert or recovery)
  run                  Run single collection cycle: both report and alert check
  send                 Send a manual notification (-t title -m message)
  test                 Send a test notification to verify pipeline
  collect              Collect and display metrics locally without sending
  targets              List available devices, topics, and groups under account
  config               Configuration: show | path | get KEY | set KEY VALUE | edit
  cron                 Scheduled tasks: install | remove | status
  logs                 View execution logs (--push to view delivery history)
  flush                Retry sending failed queued payloads from spool
  doctor               Environment diagnostics (dependencies, network, token, scheduler)
  uninstall            Uninstall tool (--purge to delete configs and state)
  version | help

$(pn_c bold 'Options')
  --api-key <pn_ak_...>      Sender Token (API Key)
  --gateway <url>            Gateway URL, default https://pushnova.ezcloud.ltd/v1
  --target-mode <mode>       device | topic | group | account
  --target <value>           Device Token / Topic Name / Group Name
  --metrics "<list>"         Monitored metrics, e.g. "load cpu mem disk"
  --report-template <name>   standard | rich | metric | table | compact
  --alert-template <name>    storm | standard | rich | compact
  --priority <level>         NORMAL | HIGH | EMERGENCY
  --interval <minutes>       Anomaly check interval in minutes
  --scheduler <type>         cron | systemd | none | auto
  --proxy <url>              Proxy URL for outbound push (e.g. http://proxy:8080)
  --dry-run                  Render payload locally without sending
  --quiet                    Quiet mode (ideal for cron, writes log only)
  --json                     Output metric results in JSON format
  -y, --yes                  Non-interactive mode (for CI / automated scripts)
  --no-test                  Skip test push during installation
  --no-schedule              Do not create scheduled jobs during installation
  -h, --help                 Display this help message

$(pn_c bold 'Examples')
  # Quick installation (Interactive wizard)
  curl -fsSL https://raw.githubusercontent.com/netproxy/pushnova/main/ops/install.sh | bash

  # Non-interactive install: push to topic 'ops_alerts', check every 5m, report daily at 09:00
  $PN_OPS_NAME install -y --api-key pn_ak_live_xxx --target-mode topic --target ops_alerts \
      --metrics "load cpu mem disk conn service log" --scheduler cron

  # Send emergency manual notification
  $PN_OPS_NAME send -t "Database Failover" -m "Failover completed successfully" --priority EMERGENCY

  # Send interactive card with approval actions (HITL)
  $PN_OPS_NAME send -t "Restart nginx?" -m "High memory usage detected" --type hitl \
      --actions "APPROVE:Approve Restart:PRIMARY,REJECT:Dismiss:DESTRUCTIVE" --timeout 300
EOF
}

pn_parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --api-key|--token|--api-key=*)
        case "$1" in
          *=*) PN_OPS_API_KEY=${1#*=}; shift ;;
          *) PN_OPS_API_KEY=${2:-}; shift 2 ;;
        esac ;;
      --gateway) PN_OPS_GATEWAY=${2:-}; shift 2 ;;
      --target-mode) PN_OPS_TARGET_MODE=${2:-}; shift 2 ;;
      --target) PN_OPS_TARGET=${2:-}; shift 2 ;;
      --metrics) PN_OPS_METRICS=${2:-}; shift 2 ;;
      --report-template) PN_OPS_REPORT_TEMPLATE=${2:-}; shift 2 ;;
      --alert-template) PN_OPS_ALERT_TEMPLATE=${2:-}; shift 2 ;;
      --recovery-template) PN_OPS_RECOVERY_TEMPLATE=${2:-}; shift 2 ;;
      --priority) PN_OPS_PRIORITY_ALERT=${2:-}; shift 2 ;;
      --interval) PN_OPS_ALERT_INTERVAL_MIN=${2:-}; shift 2 ;;
      --repeat) PN_OPS_ALERT_REPEAT_MIN=${2:-}; shift 2 ;;
      --report-cron) PN_OPS_REPORT_CRON=${2:-}; shift 2 ;;
      --alert-cron) PN_OPS_ALERT_CRON=${2:-}; shift 2 ;;
      --scheduler) PN_OPS_SCHEDULER=${2:-}; shift 2 ;;
      --proxy) PN_OPS_PROXY=${2:-}; shift 2 ;;
      --services) PN_OPS_SERVICES=${2:-}; shift 2 ;;
      --ports) PN_OPS_PORTS=${2:-}; shift 2 ;;
      --urls) PN_OPS_HTTP_URLS=${2:-}; shift 2 ;;
      --ping) PN_OPS_PING_HOSTS=${2:-}; shift 2 ;;
      --cert) PN_OPS_CERT_HOSTS=${2:-}; shift 2 ;;
      --keywords) PN_OPS_LOG_KEYWORDS=${2:-}; shift 2 ;;
      --category) PN_OPS_CATEGORY=${2:-}; shift 2 ;;
      --thresholds) PN_OPS_THRESHOLDS=${2:-}; shift 2 ;;
      --title|-t) PN_FLAG_TITLE=${2:-}; shift 2 ;;
      --message|-m) PN_FLAG_MESSAGE=${2:-}; shift 2 ;;
      --template|-T) PN_FLAG_TEMPLATE=${2:-}; shift 2 ;;
      --type) PN_FLAG_TYPE=${2:-}; shift 2 ;;
      --actions) PN_MANUAL_ACTIONS=${2:-}; shift 2 ;;
      --callback) PN_MANUAL_CALLBACK=${2:-}; shift 2 ;;
      --timeout) PN_MANUAL_TIMEOUT=${2:-}; shift 2 ;;
      --dry-run) PN_OPS_DRY_RUN=1; shift ;;
      --quiet|-q) PN_OPS_QUIET=1; shift ;;
      --json) PN_FLAG_JSON=1; shift ;;
      --yes|-y|--non-interactive) PN_FLAG_YES=1; shift ;;
      --no-test) PN_FLAG_NO_TEST=1; shift ;;
      --no-schedule) PN_OPS_SCHEDULER=none; shift ;;
      --force|-f) PN_FLAG_FORCE=1; shift ;;
      --purge) PN_FLAG_PURGE=1; shift ;;
      --verbose|-v) PN_OPS_LOG_LEVEL=debug; shift ;;
      -h|--help) pn_usage; exit 0 ;;
      --version|-V) echo "$PN_OPS_NAME v$PN_OPS_VERSION"; exit 0 ;;
      -*) pn_error "Unknown option: $1 (Use --help for usage)"; exit 2 ;;
      *)
        if [ -z "$PN_CMD" ]; then PN_CMD=$1; else PN_TAIL="$PN_TAIL $1"; fi
        shift ;;
    esac
  done
  return 0
}

# ---------------------------------------------------------------------------
# Collection & Push Flow
# ---------------------------------------------------------------------------
pn_history_push_all() {
  local kind id label value unit detail
  while IFS="$(printf '\t')" read -r kind id label value unit detail; do
    [ "$kind" = "NUM" ] || continue
    pn_history_push "$id" "$value"
  done <<EOF
$(pn_results_num)
EOF
  return 0
}

pn_severity_priority() {
  local sev=$1
  case "$sev" in
    crit) printf '%s' "${PN_OPS_PRIORITY_CRITICAL:-EMERGENCY}" ;;
    warn) printf '%s' "${PN_OPS_PRIORITY_ALERT:-HIGH}" ;;
    *)    printf '%s' "${PN_OPS_PRIORITY_REPORT:-NORMAL}" ;;
  esac
}

pn_flow_collect_eval() {
  pn_rotate_log
  pn_collect_all "${PN_OPS_METRICS:-load cpu mem disk}"
  pn_rules_evaluate
  pn_history_push_all
  return 0
}

pn_flow_push_report() {
  local tpl=${PN_FLAG_TEMPLATE:-${PN_OPS_REPORT_TEMPLATE:-standard}}
  local payload priority
  priority=$(pn_severity_priority "$PN_OVERALL")
  payload=$(pn_build_payload report "$tpl" "$priority") || return 1
  pn_notify_send "$payload" report
}

pn_flow_push_alert() {
  # pn_flow_push_alert [force]
  local force=${1:-0} tpl payload priority kinds count
  kinds=$(awk -F'\t' '$1=="ALERT"||$1=="REPEAT"{c++} END{print c+0}' "$PN_DECISIONS" 2>/dev/null)
  case "$kinds" in ''|*[!0-9]*) kinds=0 ;; esac
  if [ "$kinds" -eq 0 ]; then
    local recs
    recs=$(awk -F'\t' '$1=="RECOVERY"{c++} END{print c+0}' "$PN_DECISIONS" 2>/dev/null)
    case "$recs" in ''|*[!0-9]*) recs=0 ;; esac
    if [ "$recs" -gt 0 ] && pn_bool "${PN_OPS_NOTIFY_RECOVERY:-1}"; then
      tpl=${PN_OPS_RECOVERY_TEMPLATE:-standard}
      [ "$tpl" = "off" ] && return 0
      payload=$(pn_build_payload recovery "$tpl" "${PN_OPS_PRIORITY_REPORT:-NORMAL}" "$recs") || return 1
      pn_notify_send "$payload" recovery
      return $?
    fi
    if [ "$force" != "1" ]; then
      pn_info "No push required, silenced (no new anomalies or within cooldown period)"
      return 0
    fi
    tpl=${PN_FLAG_TEMPLATE:-${PN_OPS_ALERT_TEMPLATE:-standard}}
    payload=$(pn_build_payload report "$tpl" "${PN_OPS_PRIORITY_REPORT:-NORMAL}") || return 1
    pn_notify_send "$payload" report
    return $?
  fi
  count=$(awk -F'\t' '$1=="ALERT"||$1=="REPEAT"{ if ($6+0 > m) m=$6+0 } END{ print (m>0?m:1) }' "$PN_DECISIONS" 2>/dev/null)
  case "$count" in ''|*[!0-9]*) count=1 ;; esac
  tpl=${PN_FLAG_TEMPLATE:-${PN_OPS_ALERT_TEMPLATE:-storm}}
  priority=$(pn_severity_priority "$PN_OVERALL")
  payload=$(pn_build_payload alert "$tpl" "$priority" "$count") || return 1
  pn_notify_send "$payload" alert
}

# ---------------------------------------------------------------------------
# Command Handlers
# ---------------------------------------------------------------------------
cmd_install() {
  pn_wizard_run
}

cmd_report() {
  pn_lock report || return 0
  pn_flow_collect_eval
  if [ "$PN_FLAG_JSON" = "1" ]; then
    pn_collect_print_json
  elif ! pn_bool "${PN_OPS_QUIET:-0}"; then
    pn_format_lines
    printf '\n%s\n' "$(pn_c bold "Overview: $(pn_findings_counts)")"
  fi
  pn_ok "Inspection finished: $(pn_findings_counts)"
  pn_flow_push_report
  pn_unlock
}

cmd_check() {
  pn_lock check || return 0
  pn_flow_collect_eval
  if [ "$PN_FLAG_JSON" = "1" ]; then
    pn_collect_print_json
  elif ! pn_bool "${PN_OPS_QUIET:-0}"; then
    pn_format_lines
  fi
  if [ "$PN_FLAG_FORCE" = "1" ]; then
    pn_flow_push_alert 1
  else
    pn_flow_push_alert 0
  fi
  pn_unlock
}

cmd_run() {
  pn_lock run || return 0
  pn_flow_collect_eval
  if ! pn_bool "${PN_OPS_QUIET:-0}"; then pn_format_lines; fi
  pn_flow_push_report || pn_warn "Report push failed"
  pn_flow_push_alert 0 || pn_warn "Alert push failed"
  pn_unlock
}

cmd_collect() {
  pn_flow_collect_eval
  if [ "$PN_FLAG_JSON" = "1" ]; then
    pn_collect_print_json
  else
    pn_format_lines
    printf '\n%s\n' "$(pn_c bold "Overview: $(pn_findings_counts)")"
  fi
}

pn_collect_print_json() {
  local out="{"
  out="$out\"host\":$(pn_json_str "$(pn_hostname)")"
  out="$out,\"time\":$(pn_json_str "$(pn_time_str)")"
  out="$out,\"overall\":$(pn_json_str "$PN_OVERALL")"
  out="$out,\"crit\":$PN_CRIT_COUNT,\"warn\":$PN_WARN_COUNT,\"ok\":$PN_OK_COUNT,\"na\":$PN_NA_COUNT"
  out="$out,\"metrics\":$(pn_build_metrics_json)"
  out="$out,\"table\":$(pn_build_table_json)"
  out="$out}"
  if pn_have jq; then printf '%s\n' "$out" | jq . 2>/dev/null || printf '%s\n' "$out"
  else printf '%s\n' "$out"; fi
}

cmd_send() {
  local title=${PN_FLAG_TITLE:-} message=${PN_FLAG_MESSAGE:-}
  if [ -z "$title" ] && pn_has_tty; then
    title=$(pn_read_line "Notification Title" "PushNova Ops Notification")
  fi
  [ -n "$title" ] || title="PushNova Ops Notification"
  if [ -z "$message" ] && pn_has_tty; then
    message=$(pn_read_line "Notification Message" "")
  fi
  [ -n "$message" ] || message="$title"
  PN_MANUAL_TITLE=$title
  PN_MANUAL_MESSAGE=$message
  local tpl=${PN_FLAG_TEMPLATE:-manual}
  if [ -n "${PN_FLAG_TYPE:-}" ]; then
    case "$PN_FLAG_TYPE" in
      hitl|HITL) tpl=hitl ;;
      metric) tpl=metric ;;
      table|structured_table) tpl=table ;;
      rich|markdown) tpl=rich ;;
      *) tpl=manual ;;
    esac
  fi
  PN_OVERALL=${PN_OVERALL:-ok}
  if [ "$tpl" = "hitl" ]; then
    PN_MANUAL_ACTIONS_HINT="(Interactive buttons supported on mobile, response calls back your callback_url)"
  fi
  local payload
  payload=$(pn_build_payload manual "$tpl" "${PN_FLAG_PRIORITY_OVERRIDE:-${PN_OPS_PRIORITY_ALERT:-HIGH}}") || return 1
  pn_notify_send "$payload" manual
}

cmd_test() {
  pn_notify_selftest "${PN_FLAG_TEMPLATE:-test}"
}

cmd_targets() {
  pn_info "Fetching account info ..."
  if ! pn_api_stats; then
    pn_error "Failed to fetch account info (HTTP $PN_HTTP_CODE)"
    return 1
  fi
  local body=$PN_HTTP_BODY
  if ! pn_have jq; then
    pn_warn "jq not installed, displaying raw response:"
    printf '%s\n' "$body"
    return 0
  fi
  printf '\n%s\n' "$(pn_c bold 'Account')"
  printf '  Tier: %s · Dispatched Today: %s · Devices: %s\n' \
    "$(printf '%s' "$body" | jq -r '.tier // "-"')" \
    "$(printf '%s' "$body" | jq -r '.dispatched_today // 0')" \
    "$(printf '%s' "$body" | jq -r '(.devices // []) | length')"
  printf '\n%s\n' "$(pn_c bold 'Devices (--target-mode device --target <token>)')"
  printf '%s' "$body" | jq -r '(.devices // [])[] | "  (.device_name // "Unnamed")\t(.device_token)\t[(.group_name // "-")]"' 2>/dev/null || true
  printf '\n%s\n' "$(pn_c bold 'Topics (--target-mode topic --target <name>)')"
  printf '%s' "$body" | jq -r '(.topics // [])[] | "  (.)"' 2>/dev/null || true
  printf '\n%s\n' "$(pn_c bold 'Groups (--target-mode group --target <name>)')"
  printf '%s' "$body" | jq -r '[(.devices // [])[] | (.group_name // empty)] | unique | .[] | "  (.)"' 2>/dev/null || true
  printf '\n'
}

cmd_config() {
  local sub=${1:-show}
  case "$sub" in
    show|"") pn_conf_show ;;
    path) pn_conf_path ;;
    get)
      local k=${2:?Usage: $PN_OPS_NAME config get PN_OPS_XXX}
      pn_var_get "$k" ;;
    set)
      local k=${2:?Usage: $PN_OPS_NAME config set PN_OPS_XXX VALUE}
      shift 2
      pn_conf_set "$k" "$*" && pn_ok "Updated $k"
      ;;
    edit|wizard) pn_wizard_run ;;
    *) pn_error "Unknown subcommand: config $sub"; return 2 ;;
  esac
}

cmd_cron() {
  local sub=${1:-status}
  case "$sub" in
    install) PN_OPS_SCHEDULER=${PN_OPS_SCHEDULER:-auto}; [ "$PN_OPS_SCHEDULER" = "none" ] && PN_OPS_SCHEDULER=auto; pn_schedule_install ;;
    remove|uninstall) pn_schedule_remove ;;
    status|"") pn_schedule_status ;;
    *) pn_error "Unknown subcommand: cron $sub"; return 2 ;;
  esac
}

cmd_logs() {
  local n=50
  case "${1:-}" in
    *[0-9]*) n=$1 ;;
  esac
  if [ "${2:-}" = "--push" ] || [ "${1:-}" = "--push" ]; then
    tail -n "$n" "$(pn_state_sub logs)/push.log" 2>/dev/null || pn_info "No push delivery records"
  else
    tail -n "$n" "$(pn_log_file)" 2>/dev/null || pn_info "No execution logs"
  fi
}

cmd_flush() {
  pn_notify_flush_spool
}

cmd_doctor() {
  local fails=0 warns=0
  pn_banner "PushNova Ops Environment Diagnostics v$PN_OPS_VERSION"
  printf '  %-22s %s\n' 'Host' "$(pn_hostname) · $(pn_primary_ip)"
  printf '  %-22s %s\n' 'OS' "$(pn_os_pretty) · Kernel $(pn_kernel) · $(pn_cores) cores"
  printf '  %-22s %s\n' 'Time / Zone' "$(pn_time_str) $(date '+%Z' 2>/dev/null || echo '')"
  printf '  %-22s %s\n' 'Bash Version' "${BASH_VERSION}"
  printf '  %-22s %s\n' 'Current User' "$(id -un 2>/dev/null || echo unknown) ($(pn_is_root && echo root || echo non-root))"

  pn_banner "Dependencies"
  local t
  for t in curl awk sed grep; do
    if pn_have "$t"; then printf '  %-22s %s\n' "$t" "$(pn_c green Ready)"
    else printf '  %-22s %s\n' "$t" "$(pn_c red Missing)"; fails=$((fails + 1)); fi
  done
  for t in jq openssl ping nc smartctl crontab systemctl; do
    if pn_have "$t"; then printf '  %-22s %s\n' "$t" "$(pn_c green Ready)"
    else printf '  %-22s %s\n' "$t" "$(pn_c yellow 'Not installed (Optional)')"; warns=$((warns + 1)); fi
  done

  pn_banner "Configuration"
  printf '  %-22s %s\n' 'Config File' "$(pn_conf_path)"
  if [ -f "$(pn_conf_path)" ]; then
    local mode
    mode=$(ls -l "$(pn_conf_path)" 2>/dev/null | awk '{print $1}')
    printf '  %-22s %s\n' 'File Permissions' "$mode"
    case "$mode" in
      *rw-------*|*rw-r-----*) ;;
      *) printf '  %-22s %s\n' '' "$(pn_c yellow 'Recommend chmod 600 to protect Token')"; warns=$((warns + 1)) ;;
    esac
  else
    printf '  %-22s %s\n' '' "$(pn_c yellow 'Not configured yet, please run install')"
  fi
  printf '  %-22s %s\n' 'State Directory' "$(pn_state_dir)"
  if ! mkdir -p "$(pn_state_dir)" 2>/dev/null; then
    printf '  %-22s %s\n' '' "$(pn_c red 'Cannot create state directory')"; fails=$((fails + 1))
  fi
  printf '  %-22s %s\n' 'Sender Token' "$(pn_masked "${PN_OPS_API_KEY:-Not set}")"
  printf '  %-22s %s\n' 'Target Mode' "$(pn_target_desc)"
  printf '  %-22s %s\n' 'Metrics' "${PN_OPS_METRICS:-(empty)}"

  pn_banner "Network & Authentication"
  if pn_bool "${PN_OPS_DRY_RUN:-0}"; then
    pn_info "dry-run mode, skipping network check"
  elif [ "${PN_OPS_MOCK:-0}" = "1" ]; then
    pn_info "mock mode, skipping network check"
  else
    if pn_api_health; then
      printf '  %-22s %s\n' 'Gateway Reachable' "$(pn_c green "OK (HTTP $PN_HTTP_CODE)")"
    else
      printf '  %-22s %s\n' 'Gateway Reachable' "$(pn_c red "FAILED (HTTP $PN_HTTP_CODE): $(printf '%s' "$PN_HTTP_BODY" | cut -c1-80)")"
      fails=$((fails + 1))
    fi
    if pn_token_check; then
      printf '  %-22s %s\n' 'Token Verification' "$(pn_c green "$PN_TOKEN_SUMMARY")"
    else
      printf '  %-22s %s\n' 'Token Verification' "$(pn_c red 'Failed')"
      fails=$((fails + 1))
    fi
  fi

  pn_banner "Collection & Payload"
  pn_collect_all "${PN_OPS_METRICS:-load cpu mem disk}"
  pn_rules_evaluate
  printf '  %-22s %s\n' 'Collected Metrics' "$(pn_result_count) items"
  printf '  %-22s %s\n' 'Evaluation' "$(pn_findings_counts)"
  local payload
  if payload=$(pn_build_payload report "${PN_OPS_REPORT_TEMPLATE:-standard}" NORMAL); then
    printf '  %-22s %s\n' 'Payload Building' "$(pn_c green "Success ($(wc -c <"$payload" | tr -d ' ') bytes)")"
    pn_debug "payload: $(cat "$payload")"
  else
    printf '  %-22s %s\n' 'Payload Building' "$(pn_c red Failed)"; fails=$((fails + 1))
  fi

  pn_banner "Scheduled Tasks"
  if [ "$(uname -s 2>/dev/null)" = "Linux" ]; then
    pn_schedule_status_cron
    pn_schedule_status_systemd
  else
    printf '  Non-Linux environment, skipping scheduler diagnostics\n'
  fi

  pn_hr
  if [ "$fails" -gt 0 ]; then
    printf '  %s\n\n' "$(pn_c red "Diagnostics failed: $fails critical error(s) / $warns warning(s)")"
    return 1
  fi
  printf '  %s\n\n' "$(pn_c green "Diagnostics passed ($warns optional warning(s))")"
  return 0
}

cmd_uninstall() {
  pn_banner "Uninstall PushNova Ops"
  pn_info "Will remove: scheduled tasks"
  pn_info "Will keep: configuration and state directory (use --purge to remove both)"
  if ! pn_bool "$PN_FLAG_YES" && pn_has_tty; then
    pn_confirm "Are you sure you want to uninstall?" n || { pn_info "Cancelled"; return 0; }
  fi
  pn_schedule_remove
  if [ "$PN_FLAG_PURGE" = "1" ]; then
    rm -rf "$(pn_state_dir)" 2>/dev/null || true
    rm -f "$(pn_conf_path)" 2>/dev/null || true
    pn_ok "Removed state directory and configuration file"
  fi
  local prefix=${PN_OPS_INSTALL_PREFIX:-/opt/pushnova-ops}
  if [ "$(pn_home)" = "$prefix" ] || [ "$PN_OPS_SELFDIR" = "$prefix" ]; then
    rm -f /usr/local/bin/pushnova-ops 2>/dev/null || true
    rm -rf "$prefix" 2>/dev/null || true
    pn_ok "Removed installation directory $prefix"
  fi
  pn_ok "Uninstall completed"
  return 0
}

# ---------------------------------------------------------------------------
# Main Dispatcher
# ---------------------------------------------------------------------------
main() {
  pn_parse_args "$@"
  pn_conf_load

  if [ -z "$PN_CMD" ]; then
    if pn_has_tty; then
      pn_usage
      exit 0
    fi
    pn_error "Missing command, use --help for usage"
    exit 2
  fi

  # shellcheck disable=SC2086
  set -- $PN_TAIL
  case "$PN_CMD" in
    install|setup|wizard) cmd_install ;;
    report|digest)        cmd_report ;;
    check|alert|monitor)  cmd_check ;;
    run)                  cmd_run ;;
    collect|metrics)      cmd_collect ;;
    send|push)            cmd_send ;;
    test)                 cmd_test ;;
    targets|list)         cmd_targets ;;
    config|conf)          cmd_config "$@" ;;
    cron|schedule|timer)  cmd_cron "$@" ;;
    logs|log)             cmd_logs "$@" ;;
    flush|resend)         cmd_flush ;;
    doctor|checkup)       cmd_doctor ;;
    uninstall|remove)     cmd_uninstall ;;
    version|-V)           echo "$PN_OPS_NAME v$PN_OPS_VERSION" ;;
    help|-h|--help)       pn_usage ;;
    *) pn_error "Unknown command: $PN_CMD (Use --help for usage)"; exit 2 ;;
  esac
}

main "$@"
